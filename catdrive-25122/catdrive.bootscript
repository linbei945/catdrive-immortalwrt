setenv bootargs "root=PARTUUID=@ROOT@-02 rw rootwait"
setenv bootargs "${bootargs} console=ttyMV0,115200 earlycon=ar3700_uart,0xd0012000"

if mmc dev 0; then
	setenv mmcdev 0
elif mmc dev 1; then
	setenv mmcdev 1
fi

if test -n "${fdt_addr_r}"; then
	setenv fdt_addr ${fdt_addr_r}
fi

if test -n "${kernel_addr_r}"; then
	setenv kernel_addr ${kernel_addr_r}
fi

if test -z "${fdt_addr}"; then
	setenv fdt_addr 0x6000000
fi

if test -z "${kernel_addr}"; then
	setenv kernel_addr 0x7000000
fi

ext4load mmc ${mmcdev}:1 ${fdt_addr} armada-3720-catdrive.dtb
ext4load mmc ${mmcdev}:1 ${kernel_addr} Image

booti ${kernel_addr} - ${fdt_addr}
